<%- include('../includes/start.ejs') %>
<link rel="stylesheet" href="/css/login.css">
</head>
<%- include('../includes/navigation.ejs') %>
<main>
  <div class="login-container">
    <h2>Signup</h2>
    <h3>Create your account</h3>

    <% if (errorMessage) { %>
      <div class="login-error"><%= errorMessage %></div>
    <% } %>

    <form action="/signup" method="POST" class="login-form" novalidate>
      <label>
        Email:
        <input
        class="<%= validationErrors.find(e => e.path === 'email') ? 'invalid':'' %>"
         type="email" name="email" required value="<%= prevInput.email %>"/>
      </label>
      <label>
        Password:
        <input 
        class="<%= validationErrors.find(e => e.path === 'password') ? 'invalid':'' %>"
        type="password" name="password" required value="<%= prevInput.password %>"/>
      </label>
      <label>
        Confirm Password:
        <input
        class="<%= validationErrors.find(e => e.path === 'confirmPassword') ? 'invalid':'' %>"
         type="password" name="confirmPassword" required value="<%= prevInput.confirmPassword %>"/>
      </label>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="login-btn">Signup</button>
    </form>

    <div class="login-footer">
      <p>Have an account? <a href="/login">Login</a></p>
    </div>
  </div>
</main>
</body>
</html>
