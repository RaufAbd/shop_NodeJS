<%- include('../includes/start.ejs') %>
<link rel="stylesheet" href="/css/login.css">
</head>
<%- include('../includes/navigation.ejs') %>
<main>
  <div class="login-container">
    <h2>Login</h2>
    <h3>Access your account</h3>

    <% if (errorMessage) { %>
      <div class="login-error"><%= errorMessage %></div>
    <% } %>

    <form action="/login" method="POST" class="login-form" novalidate>
      <label>
        Email:
        <input 
        class="<%= validationErrors.find(e => e.path === 'email') ? 'invalid':'' %>"
        type="email" name="email" required value="<%= prevInput.email %>"/>
      </label>
      <label>
        Password:
        <input 
        class="<%= validationErrors.find(e => e.path === 'password') ? 'invalid':'' %>"
        type="password" name="password" required value="<%= prevInput.password %>"/>
      </label>
      <input
       type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="login-btn">Login</button>
    </form>

    <div class="login-footer">
      <p>Forgot password? <a href="/reset">Reset</a></p>
    </div>
    <div class="login-footer">
      <p>Don't have an account? <a href="/signup">Signup</a></p>
    </div>
  </div>
</main>
</body>
</html>
