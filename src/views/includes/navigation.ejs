<header class="header">
  <div class="logo">ShopZone</div>
  <ul class="nav-links">
    <li>
      <a href="/products" class="<%= url === '/products'? 'active' : '' %>"
        >Products</a
      >
    </li>
    <% if(isAuthenticated){ %>
    <li>
      <a
        href="/admin/products"
        class="<%= url === '/admin/products'? 'active' : '' %>"
        >Admin Products</a
      >
    </li>
    <li>
      <a
        href="/admin/products/add"
        class="<%= url === '/admin/products/add'? 'active' : '' %>"
        >Add Product</a
      >
    </li>

    <li>
      <a href="/cart" class="<%= url === '/cart'? 'active' : '' %>">Cart</a>
    </li>
    <li>
      <a href="/orders" class="<%= url === '/orders'? 'active' : '' %>"
        >Orders</a
      >
    </li>
    <li>
      <form action="/logout" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button
          class="navigation"
          style="background-color: rgb(180, 161, 126); margin-left: 4rem"
        >
          Logout
        </button>
      </form>
    </li>
    <% } else {%> <% if(url !== '/login'){ %>
    <li>
      <a href="/login" style="background-color: #0080ff; margin-left: 0.5rem"
        >Login</a
      >
    </li>
    <% } %> <% if(url !== '/signup'){ %>
    <li>
      <a href="/signup" style="background-color: #0080ff; margin-left: 0.5rem"
        >Signup</a
      >
    </li>
    <% } %> <% } %>
  </ul>
</header>
