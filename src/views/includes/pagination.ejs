<div class="pagination">
  <% if (currentPage > 1) { %>
  <a href="?page=<%= currentPage - 1 %>" class="btn page-btn">Prev</a>
  <% } %> <% for (let i = 1; i <= totalPages; i++) { %>
  <a
    href="?page=<%= i %>"
    class="btn page-btn <%= i === currentPage ? 'active' : '' %>"
    ><%= i %></a
  >
  <% } %> <% if (currentPage < totalPages) { %>
  <a href="?page=<%= currentPage + 1 %>" class="btn page-btn">Next</a>
  <% } %>
</div>
