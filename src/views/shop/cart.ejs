<%- include('../includes/start.ejs') %>
<link rel="stylesheet" href="/css/cart.css">
</head>
<body>
    <%- include('../includes/navigation.ejs') %>
    <main>
        <div class="cart-container">
        <h2>Shopping Cart</h2>
        <% if(cart.length) { %>
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Title</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Add/Remove</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                <% for(let product of cart){ %>
                <tr>
                    <td><img src="<%= product.image %>" alt="<%= product.title %>" width="100" height="auto"></td>
                    <td><%= product.title %></td>
                    <td>$<%= product.price %></td>
                    <td><%= product.cartItem.quantity %></td>
                    <td>
                        <div style="display: flex; gap:1rem; justify-content: center;align-items: center;">
                            <form action="/cart/add" method="POST">
                                <input type="hidden" name="itemId" value="<%= product.id %>" />
                                <button class="add btn" type="submit">+</button>
                            </form>
                            <form action="/cart/remove" method="POST">
                                <input type="hidden" name="itemId" value="<%= product.id %>" />
                                <% if(product.cartItem.quantity == 1){ %>
                                    <button class="remove btn" type="submit" disabled>-</button>
                                    <% } else { %>
                                         <button class="remove btn" type="submit">-</button>
                                        <% } %>
                               
                            </form>
                        </div>
                    <td>
                        <form action="/cart/delete" method="POST">
                            <input type="hidden" name="itemId" value="<%= product.id %>" />
                            <button class="delete btn" type="submit">x</button>
                        </form>
                    </td>
                </tr>

        <% } %>
                
            </tbody>
        </table>

        <div class="checkout-container">
            <p class="total-price">Total: $<%= cart.totalPrice %></p>
            <form action="/cart/checkout" method="POST">

                <button type="submit" class="checkout-btn">Proceed to Checkout</button>
            </form>
        </div>
        <% } else { %>
            <h3>No products in cart!</h3>
            <% } %>
    </div>


        </main>

    <%- include('../includes/end.ejs')  %>