<%- include('../includes/start.ejs') %>
<link rel="stylesheet" href="/css/order.css">
</head>
<body>
    <%- include('../includes/navigation.ejs') %>
    <main>
    
        <div class="orders-container">
            <h2>Orders</h2>

            <% if(orders.length){%>
            <h3>Manage all orders</h3>
        
            <table class="orders-table">
              <thead>
                <tr>
                  <th>#ID</th>
                  <th>Date</th>
                  <th>Total</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% for(let order of orders){ %>
                  <tr>
                    <td><%= order.id %></td>
                    <td><%= order.createdAt.getDate() + '-' + (order.createdAt.getMonth() + 1) + '-' + order.createdAt.getFullYear() %></td>
                    <td>$<%= 'order.total.toFixed(2)' %></td>
                  
                    <td>
                      <a href="/orders/<%= 'order.id' %>" class="btn view">View</a>
                      <!-- <a href="/orders/<%= 'order.id' %>/edit" class="btn add">Edit</a>
                      <form action="/orders/<%= 'order.id' %>?_method=DELETE" method="POST" class="inline-form">
                        <button type="submit" class="btn delete">Cancel</button>
                      </form> -->
                    </td>
                  </tr>
                  <% } %>
              </tbody>
            </table>

            <% } else { %>
              <h3>Nothing there!</h3>
              <% } %>
          </div>
        </main>

    <%- include('../includes/end.ejs')  %>